{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennard.local/workspace-baseline.v1.schema.json",
  "title": "WorkspaceBaseline.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflow", "planRevision", "taskEnvelopeDigest", "entries", "manifestSha256", "capturedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "planRevision": { "type": "integer", "minimum": 0 },
    "taskEnvelopeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "modifiedAt", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "modifiedAt": { "type": "string", "format": "date-time" },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capturedAt": { "type": "string", "format": "date-time" }
  }
}
