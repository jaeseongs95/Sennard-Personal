{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-suite.local/contracts/checkpoint-context-request.v1.schema.json",
  "title": "CheckpointContextRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationKey", "expectedStateToken", "status", "core", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "operationKey": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{16,128}$", "description": "Your key for this operation: make a new random one for each call (a UUID, for example), 16 to 128 characters of A-Z a-z 0-9 _ . : -. The same key with the same content answers the first result without doing the work again; the same key with other content is REQUEST_CONFLICT. The key belongs to this session, and the result is kept for 24 hours." },
    "expectedStateToken": { "type": "string", "minLength": 16, "maxLength": 256 },
    "status": { "enum": ["ACTIVE", "PAUSED", "COMPLETED"] },
    "core": { "$ref": "#/$defs/core" },
    "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "maxItems": 128 }
  },
  "$defs": {
    "boundedStrings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 64 },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "completionCriteria", "constraints", "decisions", "progress", "blockers", "nextActions"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "completionCriteria": { "$ref": "#/$defs/boundedStrings" },
        "constraints": { "$ref": "#/$defs/boundedStrings" },
        "decisions": { "$ref": "#/$defs/boundedStrings" },
        "progress": { "$ref": "#/$defs/boundedStrings" },
        "blockers": { "$ref": "#/$defs/boundedStrings" },
        "nextActions": { "$ref": "#/$defs/boundedStrings" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "locator", "digest", "verified"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
