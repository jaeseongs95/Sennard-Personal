{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sennard.local/change-scope-request.v1.schema.json",
  "title": "ChangeScopeRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "workflowId", "taskEnvelope"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "enum": ["capture", "verify"] },
    "workflowId": { "type": "string", "minLength": 1 },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "taskEnvelope": { "$ref": "https://skill-suite.local/contracts/task-envelope.v1.schema.json" },
    "baseline": { "$ref": "workspace-baseline.v1.schema.json" },
    "baselineArtifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "dependentRequired": {
    "baseline": ["baselineArtifactDigest"],
    "baselineArtifactDigest": ["baseline"]
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "verify" } } },
      "then": { "required": ["workspaceRoot"] }
    }
  ]
}
